{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qr-regen-print",
  "main": "worker.js",
  "compatibility_date": "2026-10-23",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "qr-regen-print-db",
      "database_id": "07d2f6cd-5dc0-44e5-879d-1a6e39ab31e2"
    }
  ]
}
